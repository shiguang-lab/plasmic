{
  "name": "@plasmicapp/prepass",
  "version": "2.0.0",
  "description": "Server-side React prerendering to prefetch Plasmic query data.",
  "homepage": "https://www.plasmic.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plasmicapp/plasmic.git",
    "directory": "packages/prepass"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "pnpm build:types && pnpm build:index",
    "build:types": "tsc --emitDeclarationOnly",
    "build:index": "esbuild --format=cjs --outfile=./dist/index.cjs.js ./src/index.tsx && esbuild --format=esm --outfile=./dist/index.esm.js ./src/index.tsx",
    "test": "TEST_CWD=`pwd` pnpm -w test --passWithNoTests",
    "coverage": "TEST_CWD=`pwd` pnpm -w test --coverage --passWithNoTests",
    "lint": "eslint",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "swr": "2.5.1"
  },
  "dependencies": {
    "@plasmicapp/query": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.esm.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
