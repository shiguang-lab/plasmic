       "nodeName": "NameItem",
       "name": "name",
       "label": "客群名称",
       "control": "NameInput",
       "rules": [
        {
         "ruleType": "required"
        }
       ],
       "controlWidthReason": {
        "kind": "measurement",
        "controlWidth": 240,
        "columnWidth": 360
       }
      },
      {
       "nodeName": "RetentionItem",
       "name": "retentionDays",
       "label": "数据保存天数",
       "control": "RetentionSelect",
       "rules": [],
       "controlWidthReason": {
        "kind": "measurement",
        "controlWidth": 240,
        "columnWidth": 360
       }
      },
      {
       "nodeName": "DeadlineItem",
       "name": "produceDeadline",
