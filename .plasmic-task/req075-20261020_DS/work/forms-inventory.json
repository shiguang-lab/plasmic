        "kind": "measurement",
        "controlWidth": 240,
        "columnWidth": 360
       }
      }
     ]
    }
   ],
   "standaloneControls": [
    {
     "nodeName": "SqlEditor",
     "reason": "Separate SQL validation workflow"
    }
   ]
  },
  {
   "path": "/groups/onetime-create",
   "forms": [
