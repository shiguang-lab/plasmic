{
  "name": "@shiguang-lab/plasmic-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Locally bundled Plasmic Studio with the NAS backend",
  "main": "src/entry.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "electron tests/smoke.cjs",
    "package": "node scripts/package.mjs",
    "package:mac": "node scripts/package.mjs darwin arm64",
    "package:win": "node scripts/package.mjs win32 x64",
    "package:linux": "node scripts/package.mjs linux x64",
    "test:mcp": "electron tests/mcp-smoke.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.5.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "imagetracerjs": "1.2.6",
    "jsonc-parser": "^3.3.1",
    "paper": "0.12.18",
    "pdf-lib": "1.17.1",
    "pngjs": "7.0.0",
    "smol-toml": "1.9.0"
  }
}
