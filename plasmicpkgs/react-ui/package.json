{
  "name": "@shiguang-lab/plasmic-react-ui",
  "version": "0.1.0",
  "description": "Installable React UI business components for Plasmic",
  "homepage": "https://www.plasmic.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiguang-lab/plasmic.git",
    "directory": "plasmicpkgs/react-ui"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.esm.js"
    },
    "./skinny/*": {
      "types": "./dist/*.d.ts",
      "require": "./skinny/*.cjs.js",
      "import": "./skinny/*.esm.js"
    }
  },
  "files": [
    "dist",
    "skinny"
  ],
  "scripts": {
    "build": "rm -rf dist/ skinny/ .declarations/ && rollup -c rollup.config.mjs && NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.build.json && rollup -c rollup.types.config.mjs && rm -rf .declarations",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist/ skinny/*.ts skinny/*.map skinny/*.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:interactions": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "antd": "6.7.0",
    "@shiguang-lab/plasmic-antd6": "workspace:*",
    "@ant-design/icons": "6.3.4",
    "classcat": "^5.0.5",
    "antd-style": "^4.1.0"
  },
  "devDependencies": {
    "@plasmicapp/host": "3.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@react/ui": "workspace:*",
    "rollup-plugin-dts": "catalog:",
    "rollup": "^4.62.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup-plugin-esbuild": "^6.2.1"
  },
  "peerDependencies": {
    "@plasmicapp/host": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
