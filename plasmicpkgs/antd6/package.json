{
  "name": "@shiguang-lab/plasmic-antd6",
  "version": "0.0.1",
  "description": "Ant Design 6 registrations for Plasmic",
  "homepage": "https://www.plasmic.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiguang-lab/plasmic.git",
    "directory": "plasmicpkgs/antd6"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/antd.esm.js",
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "{projectRoot}/**/*",
          "!{projectRoot}/**/dist/**/*",
          "!{projectRoot}/skinny/**/*"
        ],
        "outputs": [
          "{projectRoot}/**/dist/**/*",
          "{projectRoot}/skinny/**/*"
        ]
      }
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/antd.esm.js"
    },
    "./skinny/*": {
      "types": "./dist/*.d.ts",
      "require": "./skinny/*.cjs.js",
      "import": "./skinny/*.esm.js"
    },
    "./skinny/Form": {
      "types": "./dist/form/Form.d.ts",
      "require": "./skinny/Form.cjs.js",
      "import": "./skinny/Form.esm.js"
    },
    "./skinny/FormGroup": {
      "types": "./dist/form/FormGroup.d.ts",
      "require": "./skinny/FormGroup.cjs.js",
      "import": "./skinny/FormGroup.esm.js"
    },
    "./skinny/FormItem": {
      "types": "./dist/form/FormItem.d.ts",
      "require": "./skinny/FormItem.cjs.js",
      "import": "./skinny/FormItem.esm.js"
    },
    "./skinny/FormList": {
      "types": "./dist/form/FormList.d.ts",
      "require": "./skinny/FormList.cjs.js",
      "import": "./skinny/FormList.esm.js"
    },
    "./skinny/SchemaForm": {
      "types": "./dist/form/SchemaForm.d.ts",
      "require": "./skinny/SchemaForm.cjs.js",
      "import": "./skinny/SchemaForm.esm.js"
    },
    "./skinny/registerForm": {
      "types": "./dist/form/registerForm.d.ts",
      "require": "./skinny/registerForm.cjs.js",
      "import": "./skinny/registerForm.esm.js"
    }
  },
  "files": [
    "dist",
    "skinny"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs && NODE_OPTIONS=--max-old-space-size=8192 tsc --emitDeclarationOnly --declaration src/index.ts --incremental --tsBuildInfoFile ./dist/.tsbuildinfo  --skipLibCheck --jsx react --lib dom,esnext --esModuleInterop --strict --outDir ./dist/",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist/ skinny/*.ts skinny/*.map skinny/*.js",
    "test": "tsx --test src/*.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "antd": "6.6.5",
    "classnames": "^2.3.2",
    "dayjs": "^1.11.23",
    "fast-deep-equal": "^3.1.3",
    "lodash": "^4.17.21",
    "@ant-design/icons": "^6.0.0",
    "@shiguang-lab/plasmic-overseas": "workspace:*"
  },
  "devDependencies": {
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@plasmicapp/data-sources": "1.0.29",
    "@plasmicapp/host": "2.0.19",
    "@plasmicapp/query": "0.1.88",
    "@plasmicapp/react-web": "1.0.39",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/lodash": "catalog:",
    "@types/node": "^22.10.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "glob": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "catalog:",
    "rollup-plugin-esbuild": "catalog:",
    "rollup-plugin-replace-imports": "catalog:",
    "tsx": "catalog:"
  },
  "peerDependencies": {
    "@plasmicapp/data-sources": ">=0.1.0",
    "@plasmicapp/host": ">=1.0.0",
    "@plasmicapp/query": ">=0.1.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
