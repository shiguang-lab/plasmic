{
  "name": "@plasmicpkgs/strapi",
  "version": "0.1.0",
  "description": "Custom functions for querying Strapi content from Plasmic data queries.",
  "homepage": "https://www.plasmic.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plasmicapp/plasmic.git",
    "directory": "plasmicpkgs/strapi"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:types && pnpm build:index",
    "build:types": "tsc",
    "build:index": "node ../../build.mjs ./src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "postpublish": "bash ../../scripts/publish-api-doc-model.sh"
  },
  "dependencies": {
    "qs": "^6.16.0",
    "@types/json-logic-js": "^2.0.8",
    "@react-querybuilder/core": "8.26.0"
  },
  "devDependencies": {
    "@plasmicapp/host": "workspace:*",
    "@types/qs": "^6.9.7",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@plasmicapp/host": "^3.0.0"
  }
}
