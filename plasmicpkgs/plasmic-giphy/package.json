{
  "name": "@plasmicpkgs/plasmic-giphy",
  "version": "0.1.0",
  "description": "Plasmic Giphy components.",
  "homepage": "https://www.plasmic.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plasmicapp/plasmic.git",
    "directory": "plasmicpkgs/plasmic-giphy"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/plasmic-giphy.esm.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "test": "TEST_CWD=`pwd` pnpm -w test --passWithNoTests",
    "lint": "tsdx lint",
    "prepublishOnly": "npm run build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "size-limit": [
    {
      "path": "dist/plasmic-giphy.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/plasmic-giphy.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@plasmicapp/host": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdx": "catalog:",
    "tslib": "catalog:"
  },
  "dependencies": {
    "@giphy/js-fetch-api": "^5.1.0",
    "@giphy/js-types": "^4.4.0",
    "@giphy/react-components": "10.2.0",
    "change-case": "^4.1.2"
  }
}
