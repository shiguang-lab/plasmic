  "compositions": [
    {
      "name": "列表与抽屉",
      "parts": [
        "StandardListPage",
        "DrawerDetailSection",
        "DrawerFormSection"
      ],
      "rule": "整页只保留一个 AppShell；两个 Drawer 放在页面级，默认关闭。"
    },
    {
      "name": "已有外壳的标签列表",
      "parts": [
        "TabsTableSection",
        "DrawerDetailSection",
        "DrawerFormSection"
      ],
      "rule": "替换现有内容区，不再插入页面外壳；每个标签使用自己的 Table。"
    },
    {
      "name": "目录配置工作区",
      "parts": [
        "SplitTabsPage",
        "DrawerFormSection"
      ],
      "rule": "目录选择和标签切换分别绑定业务上下文；右栏宽度自适应，Table 独立横向滚动。"
    },
    {
      "name": "完整详情与编辑页",
      "parts": [
        "RecordDetailPage",
        "BasicFormPage"
      ],
      "rule": "是两个独立页面。使用项目真实路由关联，不将两个 AppShell 嵌套。"
    }
  ],
  "aiWorkflow": [
    "先按 useWhen、avoidWhen 和 compositions 选结构，再读取模板的实时模型。",
    "安装并核对现有库；通过真实注册名称、Props、Slots 实例化，布局优先使用 Antd。",
    "已存在 AppShell 时只使用 section 或 overlay。",
    "以普通组件方式插入 Overlay 时先解离组合实例，由当前页面绑定原生 Drawer.open 与内部 Form ref。",
    "替换示例字段、列、选项和数据；沿用组件契约，不另造控件。",
    "官方模板插入会复制布局，来源自定义 State、事件和查询不能视为自动迁移完成。重新绑定业务状态、事件和路由。",
    "用 Preview 检查查询与重置、分页、标签切换、表单校验、抽屉打开与关闭；保存后重读。"
  ],
