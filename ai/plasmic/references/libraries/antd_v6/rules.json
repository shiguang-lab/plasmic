    "components/table.md": {
      "registrations": [
        "plasmic-antd6-table",
        "plasmic-antd6-table-column",
        "plasmic-antd6-table-column-group"
      ],
      "decisions": {
        "plasmic-antd6-table": [
          {
            "prop": "size",
            "baseline": "large",
            "nullable": false,
            "rule": "component-sizes",
            "document": "../../design/scale.md",
            "note": "Set explicitly in data-props; registration defaults and templates may differ (scale.md#component-sizes)."
          },
          {
            "prop": "scroll",
            "nullable": true,
            "rule": "content-and-scroll-width",
            "note": "Numeric x greater than the explicit Column widths sum whenever any Column has a width; null keeps the native fit-to-container layout for an all-text Table without widths."
          },
          {
            "prop": "pagination",
            "nullable": false,
            "rule": "data-identity-sorting-and-pagination",
            "note": "false, or the native paging object with one declared ownership mode."
          }
        ],
        "plasmic-antd6-table-column": [
          {
            "prop": "width",
            "nullable": true,
            "rule": "content-and-scroll-width",
            "note": "Literal pixel width from the title and values; null only for the single main text Column."
          },
          {
            "prop": "presentation",
            "target": "spec",
            "nullable": false,
            "rule": "render-templates",
            "note": "Plan field, not a native prop: text (empty render Slot, native value) or custom (registered components in render), from the source presentation."
          }
        ]
      }
