      "registrations": [
        "plasmic-antd6-card",
        "plasmic-antd6-card-grid",
        "plasmic-antd6-card-meta"
      ],
      "decisions": {
        "plasmic-antd6-card": [
          {
            "prop": "size",
            "baseline": "medium",
            "nullable": false,
            "rule": "card-ownership",
            "note": "Current contract baseline."
          },
          {
            "prop": "variant",
            "baseline": "outlined",
            "nullable": false,
            "rule": "card-ownership",
            "note": "Current contract baseline; never the legacy bordered prop."
          },
          {
            "prop": "styles.body.padding",
            "nullable": false,
            "rule": "card-ownership",
            "note": "Explicit body padding from the content's edge owners: 16px 20px, 16px 20px 0 (paginated Table last), 0 20px (Tabs first) or 24px 20px 0 (Form)."
          },
          {
            "prop": "header",
            "target": "spec",
            "nullable": false,
            "rule": "card-headers",
            "note": "Plan field, not a native prop: none, title or title+extra, with headerReason (actions, collapse, count or distinguish) when not none. A header always has its title."
          }
        ]
      }
