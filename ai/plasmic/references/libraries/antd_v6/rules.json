    "components/form.md": {
      "registrations": [
        "plasmic-antd6-form",
        "plasmic-antd6-form-group",
        "plasmic-antd6-form-item",
        "plasmic-antd6-form-list"
      ],
      "decisions": {
        "plasmic-antd6-form": [
          {
            "prop": "layout",
            "nullable": false,
            "rule": "layout-ownership",
            "note": "Decide label direction before markup. Page Form: horizontal with right-aligned labels and three short fields per row; use two only with measured crowding. Modal/Drawer Form: vertical. A non-default direction needs structured layoutReason evidence, not prose.",
            "document": "compositions/form-layout.md"
          },
          {
            "prop": "labelAlign",
            "nullable": true,
            "rule": "columns-and-label-width",
            "document": "compositions/form-layout.md",
            "note": "right for horizontal labels; null for a vertical Form. Left alignment needs a source quote."
          },
          {
            "prop": "labelCol",
            "nullable": true,
            "rule": "columns-and-label-width",
            "document": "compositions/form-layout.md",
            "note": "{flex: '<px>px'} for a horizontal Page Form: the prepare_plan.py label-width estimate before markup, replaced by the rendered measurement; {flex: 'none'} for one field; null for a vertical Form."
          }
        ]
      }
