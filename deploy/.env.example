IMAGE_TAG=0.0.43
BIND_IP=100.87.115.78
STUDIO_ORIGIN=https://plasmic-studio.shiguanglab.com
CANVAS_ORIGIN=https://plasmic-canvas.shiguanglab.com
PREVIEW_ORIGIN=https://plasmic-preview.shiguanglab.com
POSTGRES_PASSWORD=replace-with-random-secret
TEMPORAL_POSTGRES_PASSWORD=replace-with-separate-random-secret
INTEGRATION_SESSION_SECRET=replace-with-random-secret
S3_ACCESS_KEY=replace-with-random-key
S3_SECRET_KEY=replace-with-random-secret
# Private identity-directory base URL reachable from the NAS containers.
SG_IDENTITY_API_URL=http://auth-service:8081
SG_IDENTITY_API_TOKEN=replace-with-identity-api-service-token
# Fetch public signing keys directly on auth-edge; avoid the public relay loop.
SG_IDENTITY_JWKS_URL=http://auth-service:8081/.well-known/jwks.json
SG_BOOTSTRAP_SUB=replace-with-existing-iam-subject
# Existing databases only: explicit one-to-one local ID -> IAM sub mapping.
SG_LEGACY_USER_MAPPING={}
